@dataclass
class LSCConfig:
    """Enhanced configuration with Chebyshev geodesic support"""
    # Core compression
    compress_ratio: float = 0.25
    threshold: float = 0.05
    learnable_threshold: bool = True
    learnable_ratio: bool = True
    
    # Compression method selection
    compression_method: str = 'fft'  # 'fft', 'chebyshev', 'hybrid'
    
    # Chebyshev-specific parameters
    chebyshev_order: int = 32
    geodesic_alpha: float = 0.1
    use_chebyshev_geodesic: bool = False
    
    # Head processing
    per_head: bool = True
    head_count: int = 12
    head_dim: Optional[int] = None
    
    # Spectral options
    use_real_fft: bool = True
    soft_eps: float = 1e-3
    spectral_norm_clip: float = 3.0
    
    # Optimization
    use_checkpointing: bool = False
    checkpoint_seq_len: int = 1024
    cache_fft_plans: bool = True
    
    # Advanced
    adaptive_compression: bool = True
    stability_mode: bool = True
    track_statistics: bool = True


class ChebyshevGeodesicCompressor(nn.Module):
    """
    Chebyshev polynomial geodesic compression.
    Preserves smoothness better than FFT for attention patterns.
    """
    
    def __init__(self, order: int = 32, geodesic_alpha: float = 0.1):
        super().__init__()
        self.order = order
        self.geodesic_alpha = geodesic_alpha
        self.geodesic_weight = nn.Parameter(torch.tensor(1.0))
    
    def compute_chebyshev_coefficients(self, x: torch.Tensor) -> torch.Tensor:
        """Project matrix onto Chebyshev polynomial basis"""
        n = x.shape[-1]
        device = x.device
        
        # Chebyshev nodes (Chebyshev-Gauss-Lobatto points)
        k = torch.arange(n, device=device, dtype=x.dtype)
        nodes = torch.cos(torch.pi * k / (n - 1))
        
        # Pre-allocate coefficients
        max_order = min(self.order, n)
        coeffs = torch.zeros(*x.shape[:-2], max_order, max_order, 
                            device=device, dtype=x.dtype)
        
        # Compute Chebyshev polynomials
        for i in range(max_order):
            T_i = torch.from_numpy(eval_chebyt(i, nodes.cpu().numpy())).to(device).float()
            for j in range(max_order):
                T_j = torch.from_numpy(eval_chebyt(j, nodes.cpu().numpy())).to(device).float()
                
                # Orthogonal projection
                basis = torch.outer(T_i, T_j)
                if len(x.shape) == 4:
                    basis = basis.unsqueeze(0).unsqueeze(0)
                
                coeffs[..., i, j] = torch.sum(x * basis, dim=(-2, -1)) / (n * n)
        
        return coeffs
    
    def reconstruct_from_coefficients(self, coeffs: torch.Tensor, n: int) -> torch.Tensor:
        """Reconstruct matrix from Chebyshev coefficients"""
        device = coeffs.device
        
        k = torch.arange(n, device=device)
        nodes = torch.cos(torch.pi * k / (n - 1))
        
        reconstructed = torch.zeros(*coeffs.shape[:-2], n, n, device=device)
        
        max_order = min(self.order, n)
        for i in range(max_order):
            T_i = torch.from_numpy(eval_chebyt(i, nodes.cpu().numpy())).to(device).float()
            for j in range(max_order):
                if torch.abs(coeffs[..., i, j]).max() > 1e-8:
                    T_j = torch.from_numpy(eval_chebyt(j, nodes.cpu().numpy())).to(device).float()
                    basis = torch.outer(T_i, T_j)
                    
                    coeff = coeffs[..., i, j]
                    while len(coeff.shape) < len(reconstructed.shape):
                        coeff = coeff.unsqueeze(-1)
                    
                    reconstructed += coeff * basis
        
        return reconstructed
    
    def geodesic_threshold(self, coeffs: torch.Tensor, ratio: float) -> torch.Tensor:
        """Threshold using geodesic distance minimization"""
        original_shape = coeffs.shape
        coeffs_flat = coeffs.reshape(*coeffs.shape[:-2], -1)
        
        # Geodesic importance score
        importance = torch.abs(coeffs_flat) * torch.exp(-self.geodesic_alpha * coeffs_flat ** 2)
        
        # Keep top-k coefficients
        k = max(1, int(ratio * coeffs_flat.shape[-1]))
        topk_values, topk_indices = torch.topk(importance, k, dim=-1)
        
        # Create sparse mask
        mask = torch.zeros_like(coeffs_flat)
        mask.scatter_(-1, topk_indices, 1.0)
        
        # Apply mask with geodesic weighting
        coeffs_compressed = coeffs_flat * mask * self.geodesic_weight
        
        return coeffs_compressed.reshape(original_shape)
    
    def forward(self, x: torch.Tensor, compress_ratio: float = 0.25) -> torch.Tensor:
        """Chebyshev geodesic compression"""
        n = x.shape[-1]
        
        # Compute Chebyshev coefficients
        coeffs = self.compute_chebyshev_coefficients(x)
        
        # Geodesic thresholding
        coeffs_compressed = self.geodesic_threshold(coeffs, compress_ratio)
        
        # Reconstruct
        x_compressed = self.reconstruct_from_coefficients(coeffs_compressed, n)
        
        return x_compressed


class FFTCompressor(nn.Module):
    """Standard FFT-based compression (original method)"""
    
    def __init__(self, threshold: float = 0.05):
        super().__init__()
        self.threshold = threshold
    
    def forward(self, x: torch.Tensor, compress_ratio: float = 0.25) -> torch.Tensor:
        """FFT compression"""
        # 2D FFT
        x_fft = torch.fft.fft2(x)
        
        # Get magnitude spectrum
        magnitude = torch.abs(x_fft)
        
        # Threshold
        threshold_val = self.threshold * torch.max(magnitude)
        mask = magnitude > threshold_val
        
        # Apply mask
        x_fft_compressed = x_fft * mask
        
        # Inverse FFT
        x_compressed = torch.fft.ifft2(x_fft_compressed).real
        
        return x_compressed


class HybridCompressor(nn.Module):
    """
    Hybrid: Auto-selects FFT or Chebyshev based on attention pattern.
    """
    
    def __init__(self, fft_comp: FFTCompressor, cheb_comp: ChebyshevGeodesicCompressor):
        super().__init__()
        self.fft_comp = fft_comp
        self.cheb_comp = cheb_comp
    
    def analyze_pattern(self, x: torch.Tensor) -> str:
        """Analyze attention pattern to select best method"""
        # Compute smoothness
        grad_norm = torch.norm(x[..., 1:, :] - x[..., :-1, :]) / x.numel()
        
        # Compute sparsity
        sparsity = (x.abs() < 1e-3).float().mean()
        
        # Decision rules
        if grad_norm < 0.05:  # Very smooth
            return 'chebyshev'
        elif sparsity > 0.7:  # Very sparse
            return 'fft'
        else:
            return 'hybrid'
    
    def forward(self, x: torch.Tensor, compress_ratio: float = 0.25) -> torch.Tensor:
        """Hybrid compression"""
        method = self.analyze_pattern(x)
        
        if method == 'chebyshev':
            return self.cheb_comp(x, compress_ratio)
        elif method == 'fft':
            return self.fft_comp(x, compress_ratio)
        else:
            # Blend both methods
            y_fft = self.fft_comp(x, compress_ratio)
            y_cheb = self.cheb_comp(x, compress_ratio)
            return 0.5 * y_fft + 0.5 * y_cheb


class EnhancedLSCEngine(nn.Module):
    """
    Enhanced LSC Engine with multiple compression backends.
    Production-ready with full backward compatibility.
    """
    
    def __init__(self, config: LSCConfig):
        super().__init__()
        self.config = config
        
        # Initialize compressors
        self.fft_compressor = FFTCompressor(threshold=config.threshold)
        self.chebyshev_compressor = ChebyshevGeodesicCompressor(
            order=config.chebyshev_order,
            geodesic_alpha=config.geodesic_alpha
        )
        self.hybrid_compressor = HybridCompressor(
            self.fft_compressor,
            self.chebyshev_compressor
        )
        
        # Learnable parameters
        if config.learnable_ratio:
            self.ratio_param = nn.Parameter(torch.tensor(config.compress_ratio))
        else:
            self.register_buffer('ratio_param', torch.tensor(config.compress_ratio))
        
        # Statistics tracking
        self.stats = {
            'fft_calls': 0,
            'chebyshev_calls': 0,
            'hybrid_calls': 0,
            'total_calls': 0
        }
    
    def compress(self, x: torch.Tensor, method: Optional[str] = None) -> torch.Tensor:
        """
        Compress attention map using specified method.
        
        Args:
            x: attention map [batch, heads, seq, seq] or [seq, seq]
            method: 'fft', 'chebyshev', 'hybrid', or None (use config)
            
        Returns:
            compressed attention map
        """
        if method is None:
            method = self.config.compression_method
        
        ratio = self.ratio_param.item() if self.config.learnable_ratio else self.config.compress_ratio
        
        # Select compression method
        if method == 'chebyshev':
            result = self.chebyshev_compressor(x, ratio)
            self.stats['chebyshev_calls'] += 1
        elif method == 'hybrid':
            result = self.hybrid_compressor(x, ratio)
            self.stats['hybrid_calls'] += 1
        else:  # 'fft' (default)
            result = self.fft_compressor(x, ratio)
            self.stats['fft_calls'] += 1
        
        self.stats['total_calls'] += 1
        
        return result
    
    def compare_methods(self, x: torch.Tensor) -> Dict:
        """Compare all compression methods"""
        ratio = self.ratio_param.item() if self.config.learnable_ratio else self.config.compress_ratio
        
        # Compress with each method
        y_fft = self.fft_compressor(x, ratio)
        y_cheb = self.chebyshev_compressor(x, ratio)
        y_hybrid = self.hybrid_compressor(x, ratio)
        
        # Compute metrics
        results = {}
        for name, y in [('fft', y_fft), ('chebyshev', y_cheb), ('hybrid', y_hybrid)]:
            mse = F.mse_loss(x, y).item()
            mae = F.l1_loss(x, y).item()
            
            # Compute relative error
            rel_error = torch.norm(x - y) / (torch.norm(x) + 1e-10)
            
            results[name] = {
                'mse': mse,
                'mae': mae,
                'relative_error': rel_error.item()
            }
        
        # Find best method
        best_method = min(results.keys(), key=lambda k: results[k]['mse'])
        
        return {
            'methods': results,
            'best_method': best_method,
            'improvements': {
                'chebyshev_vs_fft': (results['fft']['mse'] - results['chebyshev']['mse']) / results['fft']['mse'] * 100,
                'hybrid_vs_fft': (results['fft']['mse'] - results['hybrid']['mse']) / results['fft']['mse'] * 100
            }
        }
    
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """Forward pass with configured method"""
        return self.compress(x)
    
    def get_stats(self) -> Dict:
        """Get compression statistics"""
        return self.stats.copy()


