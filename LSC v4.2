        self.output_dir = Path(output_dir)
        self.output_dir.mkdir(parents=True, exist_ok=True)
        
        # Load model
        print(f"📦 Loading model: {model_name}")
        from transformers import AutoModelForSequenceClassification, AutoTokenizer
        self.model = AutoModelForSequenceClassification.from_pretrained(model_name)
        self.model = self.model.to(self.device)
        self.tokenizer = AutoTokenizer.from_pretrained(model_name)
        
        # Initialize enhanced LSC engine
        config = LSCConfig(
            compression_method='hybrid',
            use_chebyshev_geodesic=True,
            compress_ratio=0.25,
            threshold=0.05
        )
        self.lsc_engine = EnhancedLSCEngine(config).to(self.device)
        
        print(f"✅ Initialized with {config.compression_method} compression")
    
    def run_all_analyses(self) -> Dict:
        """Run all 8 core analyses"""
        
        print("\n" + "═" * 80)
        print("🧠 LSC v4.2 COMPREHENSIVE ANALYSIS PIPELINE")
        print("═" * 80)
        
        results = {}
        
        # 1. Per-head Attention Analysis
        print("\n1️⃣  Per-head/Per-layer Attention Analysis")
        results['attention'] = self._analyze_attention_patterns()
        
        # 2. Compression Method Comparison (NEW)
        print("\n2️⃣  Compression Method Comparison (FFT vs Chebyshev vs Hybrid)")
        results['method_comparison'] = self._analyze_compression_methods()
        
        # 3. Sequence Length Scaling
        print("\n3️⃣  Sequence Length Scaling Analysis")
        results['scaling'] = self._analyze_sequence_scaling()
        
        # 4. Model Scale Comparison
        print("\n4️⃣  Model Scale Comparison")
        results['model_scale'] = self._analyze_model_scales()
        
        # 5. Activation vs Weights Breakdown
        print("\n5️⃣  Compression Breakdown Analysis")
        results['breakdown'] = self._analyze_compression_breakdown()
        
        # 6. Robustness Analysis
        print("\n6️⃣  Robustness/OOD Analysis")
        results['robustness'] = self._analyze_robustness()
        
        # 7. Hyperparameter Sensitivity
        print("\n7️⃣  Hyperparameter Sensitivity")
        results['hyperparams'] = self._analyze_hyperparameters()
        
